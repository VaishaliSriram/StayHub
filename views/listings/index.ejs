<div class="categories-container">
    
    <a href="/listings" class="category-btn active">All</a>

    <a href="/listings/category/Beach" class="category-btn">🏖️ Beach</a>

    <a href="/listings/category/Mountain" class="category-btn">⛰️ Mountain</a>

    <a href="/listings/category/Camping" class="category-btn">🏕️ Camping</a>

    <!-- <a href="/listings/category/City" class="category-btn">🏙️ City</a> -->

    <a href="/listings/category/Castle" class="category-btn">🏰 Castle</a>

    <a href="/listings/category/Tropical" class="category-btn">🌴 Tropical</a>

    <a href="/listings/category/Farm" class="category-btn">🚜 Farm</a>

    <a href="/listings/category/Arctic" class="category-btn">❄️ Arctic</a>

    <a href="/listings/category/Luxury" class="category-btn">✨ Luxury</a>

</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">

<% if(allListings.length === 0) { %>
    <h5>No listings found 😢</h5>
<% } %>

<% for(let listing of allListings){ %>

    <a href="/listings/<%= listing._id %>" class="listing-link text-decoration-none text-dark">

        <div class="card listing-card h-100 shadow-sm">

            <img
                src="<%= listing.image?.url || 'https://via.placeholder.com/300' %>"
                class="card-img-top"
                alt="listing-image"
                style="height: 20rem; object-fit: cover;"
            />

            <div class="card-body">

                <p class="card-text">
                    <b><%= listing.title %></b>
                    <br>

                    <% if(listing.category){ %>
                        <span class="badge bg-secondary">
                            <%= listing.category %>
                        </span>
                        <br>
                    <% } %>

                    ₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %>/night
                </p>

            </div>

        </div>

    </a>

<% } %>

</div>